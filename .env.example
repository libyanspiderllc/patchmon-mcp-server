# For Docker Compose, copy this file to .env and fill in your real values.
# .env is git-ignored — never commit real credentials.

PATCHMON_URL=https://patchmon.example.com
PATCHMON_API_KEY=patchmon_ae_your_key_here
PATCHMON_API_SECRET=your_secret_here

# Optional
PATCHMON_API_VERSION=v1
PATCHMON_VERIFY_SSL=true
PATCHMON_TIMEOUT=30

# Required for Streamable HTTP. Generate a separate secret with openssl rand -hex 32.
MCP_AUTH_TOKEN=

# Host interface and port for Docker Compose
HOST=127.0.0.1
MCP_PORT=8000
